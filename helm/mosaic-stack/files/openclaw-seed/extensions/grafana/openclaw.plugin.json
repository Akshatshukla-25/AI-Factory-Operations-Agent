{
  "id": "grafana",
  "contracts": {
    "tools": [
      "grafana_dashboard_health",
      "grafana_dashboard_presets",
      "grafana_dashboard_validate",
      "grafana_dashboard_create",
      "grafana_dashboard_open"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "grafanaUrl": {
        "type": "string",
        "description": "Grafana service base URL."
      },
      "prometheusUrl": {
        "type": "string",
        "description": "Prometheus-compatible query base URL, including any VictoriaMetrics cluster tenant prefix."
      },
      "uiUrl": {
        "type": "string",
        "description": "UI service base URL used to switch the frontend Grafana tab."
      },
      "datasourceUid": {
        "type": "string",
        "description": "Grafana Prometheus datasource UID."
      },
      "token": {
        "type": "string",
        "description": "Optional Grafana API token."
      },
      "basicUser": {
        "type": "string",
        "description": "Optional Grafana basic auth user."
      },
      "basicPassword": {
        "type": "string",
        "description": "Optional Grafana basic auth password."
      },
      "enabledTools": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Optional allowlist of Grafana tool names to register."
      },
      "disabledTools": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Optional list of Grafana tool names to suppress."
      },
      "datasourceType": {
        "type": "string",
        "enum": [
          "prometheus",
          "victoriametrics-metrics-datasource"
        ],
        "description": "Grafana metrics datasource type. Defaults to prometheus."
      }
    },
    "required": ["grafanaUrl", "prometheusUrl", "datasourceUid"]
  }
}
